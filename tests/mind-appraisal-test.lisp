(in-package #:pai-v3.test)
(use-package '#:pai-v3.mind)
(defparameter *operator* (obj "principal_type" "operator"))

(defun typed-answer (&key (appreciation 0) (connection 0) (curiosity 0) (closure 2) (valence 2) (arousal 2) (confidence 1d0))
  (let ((answers (obj)))
    (loop for name in '("appreciation" "connection" "curiosity" "closure" "valence" "arousal")
          for s in (list appreciation connection curiosity closure valence arousal)
          for count = (if (member name '("appreciation" "connection" "curiosity") :test #'equal) 4 5)
          do (let ((probabilities (obj)))
               (dotimes (i count) (setf (gethash (write-to-string i) probabilities) (if (= i s) 1d0 0d0)))
               (setf (gethash name answers) (obj "type" "score" "score" s "confidence" confidence "probabilities" probabilities))))
    (obj "model" "typesafe/jev-1.13-test" "answers" answers
         "usage" (obj "input_tokens" 100 "output_tokens" 10 "cost" 0.0000042))))

(defun decision-profile (callback)
  (make-provider-profile :name "affect-jev" :model "typesafe/jev-1.13" :base-url "https://openrouter.ai/api/v1"
                         :secret "openrouter" :microusd-per-1k-prompt 42 :transport callback))

(defun mock-decision (response &optional (status 200))
  (decision-profile (lambda (url headers body &key timeout)
                      (declare (ignore url headers body timeout))
                      (values status nil (if (stringp response) response (json-encode response))))))

(defun turn (k text)
  (receive-turn k :channel "web" :audience "operator" :speaker "Operator" :text text :origin *operator*))
(defun appraisal-key (event) (format nil "turn:~d" (event-id event)))
(defun drive (k name) (obj-get (nth-value 1 (affect-now k)) name))
(defun approx (a b) (< (abs (- a b)) 0.000001d0))
(defmacro with-appraisal ((k) &body body)
  `(with-clock
     (with-temp-kernel (,k)
       (advance 43200)
       (change-setting ,k "affect.appraisal.enabled" t :origin *operator*)
       ,@body)))

(deftest semantic-appraisal-precedes-the-reply-and-replaces-keyword-rules
  (with-appraisal (k)
    (let* ((asked 0) (seen nil)
           (pai-v3.mind::*decision-profile*
             (decision-profile (lambda (url headers body &key timeout)
                                 (incf asked) (setf seen (json-parse body))
                                 (is (equal url "https://openrouter.ai/api/alpha/decisions"))
                                 (is (equal '(:secret "openrouter" "Bearer ~a") (cdr (assoc "Authorization" headers :test #'equal))))
                                 (is (= timeout 2))
                                 (values 200 nil (json-encode (typed-answer :appreciation 3 :connection 2 :valence 4))))))
           (event (turn k "Thank you for solving that specific problem."))
           (id (request-thought k "responding" "The operator spoke" :source-event-id (event-id event))))
      (is (approx 0.2 (drive k "connection")) "no flat satisfaction before semantic judgment")
      (is (approx 0.1 (drive k "appreciation")) "no keyword satisfaction")
      (is (equal "affect-appraise" (sql-value (kernel-db k) "SELECT handler FROM v3_work WHERE status=?1 ORDER BY priority,id LIMIT 1" "queued")))
      (is (eq :ran (first (run-scheduler-step k))))
      (is (equal "queued" (getf (work-status k (sql-value (kernel-db k) "SELECT id FROM v3_work WHERE handler=?1 AND entity=?2 LIMIT 1" "thought" (write-to-string id))) :status)))
      (is (approx (* 0.2 (- 1 (* (/ 2d0 3) 0.7))) (drive k "connection")))
      (is (approx 0.03 (drive k "appreciation")))
      (is (approx 0.58 (obj-get (affect-now k) "valence")))
      (is (equal "applied" (getf (pai-v3.mind::appraisal-row k (appraisal-key event)) :status)))
      (is (eq t (obj-get (obj-get seen "provider") "zdr")))
      (is (equal "deny" (obj-get (obj-get seen "provider") "data_collection")))
      (is (= 6 (hash-table-count (obj-get seen "questions"))))
      (is (= 4 (spent-today k "operator")))
      (let ((frame (funcall pai-v3.mind::*assemble-thought-context* k (thought-row k id) nil)))
        (is (search "appreciation=0.03" (json-encode frame))))
      (pai-v3.mind::request-affect-appraisal k (event-id event) "operator" "Operator" "duplicate" (appraisal-key event))
      (is (= asked 1)))))

(deftest neutral-sarcasm-and-quoted-praise-can-produce-no-change
  ;; Semantic accuracy is separately evaluated against the live pinned model.
  (with-appraisal (k)
    (let* ((pai-v3.mind::*decision-profile* (mock-decision (typed-answer)))
           (event (turn k "She said 'thank you'; that wasn't addressed to you.")))
      (run-scheduler-step k)
      (is (approx 0.1 (drive k "appreciation"))))
    (let* ((response (typed-answer :confidence 0.2d0))
           (ignored (dolist (name '("appreciation" "connection"))
                      (setf (gethash name (obj-get response "answers"))
                            (obj "type" "score" "score" 0.6d0 "confidence" 0.2d0
                                 "probabilities" (obj "0" 0.8d0 "1" 0d0 "2" 0d0 "3" 0.2d0)))))
           (pai-v3.mind::*decision-profile* (mock-decision response))
           (event (turn k "Thanks for nothing.")))
      (declare (ignore event ignored))
      (run-scheduler-step k)
      (is (approx 0.1 (drive k "appreciation")))
      (is (approx 0.2 (drive k "connection"))))))

(deftest factors-use-personal-gains-and-finished-events-are-idempotent
  (with-appraisal (k)
    (change-setting k "affect.drives" (obj "curiosity" (obj "trigger_amount" 0.6)
                                         "closure" (obj "trigger_amount" 0.2)
                                         "appreciation" (obj "satisfaction_drop" 0.5)) :origin *operator*)
    (let* ((pai-v3.mind::*decision-profile* (mock-decision (typed-answer :appreciation 3 :curiosity 3 :closure 0)))
           (event (turn k "An interesting new question")))
      (run-scheduler-step k)
      (is (approx 0.6 (drive k "curiosity")))
      (is (approx 0.2 (drive k "closure")))
      (is (approx 0.05 (drive k "appreciation")))
      (let* ((done (event-by-id k (first (latest-event-ids k "affect.appraisal.finished" 1))))
             (payload (event-payload done)))
        (append! k "affect.appraisal.finished" payload)
        (is (approx 0.6 (drive k "curiosity")))
        (is (approx 0.05 (drive k "appreciation")))))))

(deftest failures-and-deadlines-leave-the-conversation-eligible
  (with-appraisal (k)
    (dolist (profile (list (mock-decision "nope") (mock-decision "" 429)
                           (mock-decision (obj "model" "typesafe/jev-1.13" "usage" (obj "input_tokens" 10 "output_tokens" 1 "cost" 0.000001)))
                           (decision-profile (lambda (&rest ignore) (declare (ignore ignore)) (error "network")))))
      (let* ((pai-v3.mind::*decision-profile* profile)
             (event (turn k "Thank you")))
        (is (eq :ran (first (run-scheduler-step k))))
        (is (equal "failed" (getf (pai-v3.mind::appraisal-row k (appraisal-key event)) :status)))
        (is (approx 0.1 (drive k "appreciation")))
        (is (null (dead-letters k)))))
    (change-setting k "affect.appraisal.timeout_seconds" 1 :origin *operator*)
    (let* ((pai-v3.mind::*decision-profile*
             (decision-profile (lambda (&rest ignore) (declare (ignore ignore)) (sleep 10))))
           (event (turn k "A deadline fixture")) (start (get-internal-real-time)))
      (run-scheduler-step k)
      (is (< (/ (- (get-internal-real-time) start) internal-time-units-per-second) 3))
      (is (equal "failed" (getf (pai-v3.mind::appraisal-row k (appraisal-key event)) :status))))))

(deftest crash-recovery-reuses-paid-results-or-records-uncertainty
  (with-appraisal (k)
    (let* ((event (turn k "A receipt fixture")) (key (appraisal-key event))
           (work (sql-value (kernel-db k) "SELECT id FROM v3_work WHERE handler=?1 AND entity=?2 LIMIT 1" "affect-appraise" key))
           (asked 0) (pai-v3.mind::*decision-profile* (decision-profile (lambda (&rest ignore) (declare (ignore ignore)) (incf asked) (error "must not call")))))
      (append! k "affect.appraisal.started" (obj "source_key" key "work_id" work))
      (pai-v3.mind::decide k (mock-decision (typed-answer :appreciation 3)) key (obj) (obj) :work-id work :lane "operator")
      (is (= 4 (spent-today k "operator")))
      (run-scheduler-step k)
      (is (= 0 asked)) (is (approx 0.03 (drive k "appreciation")))
      (is (= 4 (spent-today k "operator")) "recovery does not rebill")
      (let* ((event2 (turn k "An uncertain fixture")) (key2 (appraisal-key event2))
             (work2 (sql-value (kernel-db k) "SELECT id FROM v3_work WHERE handler=?1 AND entity=?2 LIMIT 1" "affect-appraise" key2)))
        (append! k "affect.appraisal.started" (obj "source_key" key2 "work_id" work2))
        (run-scheduler-step k)
        (is (equal "uncertain" (getf (pai-v3.mind::appraisal-row k key2) :status)))
        (is (= 0 asked))))))

(deftest context-has-no-later-messages-or-other-audience-private-material
  (with-appraisal (k)
    (turn k "SYNTHETIC_PRIVATE_OPERATOR_HISTORY")
    (append! k "drive.triggered" (obj "drive" "curiosity" "amount" 0.3 "target" "SYNTHETIC_PRIVATE_TARGET"))
    (let* ((event (turn k "The message being appraised")) (row (pai-v3.mind::appraisal-row k (appraisal-key event))))
      (turn k "SYNTHETIC_FUTURE_MESSAGE")
      (let ((text (json-encode (pai-v3.mind::appraisal-state k row))))
        (is (search "SYNTHETIC_PRIVATE_OPERATOR_HISTORY" text))
        (is (not (search "SYNTHETIC_FUTURE_MESSAGE" text)))))
    (let* ((source (event-id (append! k "notice.posted" (obj "channel" "test" "audience" "peer:beta" "text" "Synthetic source" "importance" "normal")))))
      (pai-v3.mind::request-affect-appraisal k source "peer:beta" "Beta" "A peer message" "peer:beta/message:p1")
      (let ((text (json-encode (pai-v3.mind::appraisal-state k (pai-v3.mind::appraisal-row k "peer:beta/message:p1")))))
        (is (not (search "SYNTHETIC_PRIVATE_OPERATOR_HISTORY" text)))
        (is (not (search "SYNTHETIC_PRIVATE_TARGET" text)))))))

(deftest budget-and-staleness-use-existing-scheduler-admission
  (with-appraisal (k)
    (change-setting k "budget.daily_microusd" 0 :origin *operator*)
    (let* ((called 0) (pai-v3.mind::*decision-profile* (decision-profile (lambda (&rest ignore) (declare (ignore ignore)) (incf called))))
           (event (turn k "Budget fixture")))
      (is (eq :deferred (first (run-scheduler-step k))))
      (is (= 0 called))
      (is (equal "queued" (getf (pai-v3.mind::appraisal-row k (appraisal-key event)) :status)))
      (advance 301)
      (change-setting k "budget.daily_microusd" 2000000 :origin *operator*)
      (run-scheduler-step k)
      (is (= 0 called))
      (is (equal "skipped" (getf (pai-v3.mind::appraisal-row k (appraisal-key event)) :status))))))

(deftest payload-bounds-preserve-unicode-and-visible-truncation
  (with-appraisal (k)
    (let* ((source (event-id (append! k "notice.posted" (obj "channel" "test" "audience" "operator" "text" "fixture" "importance" "normal"))))
           (text (make-string 10000 :initial-element #\Null)))
      (pai-v3.mind::request-affect-appraisal k source "operator" "Operator" text "bound-test" :context text)
      (let* ((row (pai-v3.mind::appraisal-row k "bound-test"))
             (state (json-encode (pai-v3.mind::appraisal-state k row))))
        (is (getf row :truncated))
        (is (< (length (babel:string-to-octets state :encoding :utf-8)) 20000))
        (is (< (length (babel:string-to-octets
                        (json-encode (obj "model" "typesafe/jev-1.13" "state" (pai-v3.mind::appraisal-state k row)
                                          "questions" pai-v3.mind::+appraisal-questions+)) :encoding :utf-8)) 32000))))))

(deftest historical-turns-retain-their-old-affect-semantics
  (with-appraisal (k)
    (append! k "turn.received" (obj "channel" "fixture" "audience" "operator" "speaker" "Operator"
                                  "text" "Thank you" "origin" *operator*))
    (is (approx 0.03 (drive k "appreciation")))
    (is (approx 0.06 (drive k "connection")))))

(deftest uncertainty-about-strength-is-distinct-from-uncertainty-about-occurrence
  (with-appraisal (k)
    (let* ((response (typed-answer))
           (ignored (setf (gethash "appreciation" (obj-get response "answers"))
                          (obj "type" "score" "score" 2.5d0 "confidence" 0d0
                               "probabilities" (obj "0" 0d0 "1" 0d0 "2" 0.5d0 "3" 0.5d0))))
           (pai-v3.mind::*decision-profile* (mock-decision response)))
      (declare (ignore ignored))
      (turn k "Clear sincere appreciation; strength between specific and strong.")
      (run-scheduler-step k)
      (is (< (drive k "appreciation") 0.05)))))

(deftest appraisal-model-is-selected-by-profile-not-a-vendor-allowlist
  (with-appraisal (k)
    (change-setting k "llm.profiles"
                    (list (obj "name" "mercury" "model" "inception/mercury-decide"
                               "base_url" "https://openrouter.ai/api/v1" "secret" "synthetic"))
                    :origin *operator*)
    (change-setting k "affect.appraisal.profile" "mercury" :origin *operator*)
    (let* ((pai-v3.mind::*decision-profile* nil)
           (profile (pai-v3.mind::%appraisal-profile k))
           (seen nil)
           (response (typed-answer :appreciation 3)))
      (is (equal "inception/mercury-decide" (pai-v3.mind::provider-profile-model profile)))
      (setf (gethash "model" response) "inception/mercury-decide-20260930"
            (pai-v3.mind::provider-profile-transport profile)
            (lambda (url headers body &key timeout)
              (declare (ignore url headers timeout))
              (setf seen (json-parse body))
              (values 200 nil (json-encode response))))
      (let ((pai-v3.mind::*decision-profile* profile))
        (turn k "Thank you for your specific contribution.")
        (run-scheduler-step k))
      (is (equal "inception/mercury-decide" (obj-get seen "model")))
      (is (approx 0.03 (drive k "appreciation")))
      (is (search "inception/mercury-decide-20260930"
                  (sql-value (kernel-db k) "SELECT text FROM provider_decisions WHERE request_key=?1 AND part=?2 LIMIT 1"
                             (sql-value (kernel-db k) "SELECT source_key FROM affect_appraisals WHERE status=?1 LIMIT 1" "applied") 0)))
      ;; A later selection cannot invalidate a paid receipt from the old model.
      (setf (gethash "model" response) "typesafe/jev-1.14-synthetic")
      (is (hash-table-p (pai-v3.mind::%appraisal-judgment response)))
      (setf (gethash "model" response) " ")
      (signals error (pai-v3.mind::%appraisal-judgment response))
      (setf (gethash "model" response) "inception/mercury-decide"
            (gethash "answers" response) (obj "appreciation" (obj "type" "choice")))
      (signals error (pai-v3.mind::%appraisal-judgment response)))
    (change-setting k "llm.profiles"
                    (list (obj "name" "mercury" "model" " " "base_url" "https://openrouter.ai/api/v1"))
                    :origin *operator*)
    (let ((pai-v3.mind::*decision-profile* nil))
      (signals error (pai-v3.mind::%appraisal-profile k)))))

(run-suite "mind-appraisal")
