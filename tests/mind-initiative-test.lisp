(in-package #:pai-v3.test)
(use-package '#:pai-v3.mind)

(deftest initiative-guidance-is-consistent-and-audience-scoped
  (with-temp-kernel (k)
    (dolist (origin '("introspection" "reflection" "concern" "docket" "noticing" "unbidden" "private" "work"))
      (let* ((row (list :origin origin :audience "operator" :id 0 :reason "Synthetic task"))
             (frame (funcall pai-v3.mind::*assemble-thought-context* k row "TOOL_INDEX"))
             (prefix (obj-get (first frame) "content")))
        (is (search "Treat an inferred need as a possibility" prefix))
        (is (search "When a drive is high enough, consider actions that would satisfy it" prefix))
        (is (search "document" prefix))
        (is (search "If nothing warrants action" prefix))
        (is (search "TOOL_INDEX" prefix))
        (is (not (search "Choosing a useful contribution" (obj-get (third frame) "content"))))))
    (dolist (audience '("external" "coding-agent" "person:guest"))
      (let ((frame (funcall pai-v3.mind::*assemble-thought-context* k
                           (list :origin "work" :audience audience :id 0 :reason "Synthetic task") nil)))
        (is (search "Choosing a useful contribution" (json-encode frame)))))
    (is (null (pai-v3.mind::initiative-guidance (list :origin "responding" :audience "operator"))))))

(deftest private-initiative-has-a-draft-boundary-and-making-tools-in-hand
  (dolist (origin '("introspection" "reflection" "concern" "docket" "noticing" "unbidden" "private"))
    (let* ((row (list :origin origin :audience "operator"))
           (available (tools-for row))
           (hand (pai-v3.mind::tools-in-hand row available nil)))
      (is (pai-v3.mind::private-initiative-p row))
      (is (find "draft_forum_post" hand :key #'pai-v3.mind::tool-name :test #'equal))
      (is (find "work_docket" hand :key #'pai-v3.mind::tool-name :test #'equal))
      (dolist (name '("post_fleet_message" "reply_fleet_board_message" "post_fleet_board"))
        (is (not (find name available :key #'pai-v3.mind::tool-name :test #'equal))))))
  (let* ((row (list :origin "docket" :audience "operator"))
         (hand (pai-v3.mind::tools-in-hand row (tools-for row) nil)))
    (is (find "document" hand :key #'pai-v3.mind::tool-name :test #'equal)))
  (let ((row (list :origin "work" :audience "peer:beta")))
    (is (pai-v3.mind::private-initiative-p row))
    (is (not (pai-v3.mind::tool-available-p (gethash "post_fleet_message" *tools*) row)))))

(deftest review-exploration-and-making-keep-their-specific-tasks
  (let ((review (pai-v3.mind::conversation-review-prompt))
        (wander (pai-v3.mind::rumination-prompt '("SYNTHETIC_MEMORY") "SYNTHETIC_SUMMARY"))
        (concern (pai-v3.mind::concern-visit-prompt "c1" "curiosity" "SYNTHETIC_QUESTION" "why" nil 1 4 20 0))
        (repair (pai-v3.mind::concern-visit-prompt "c2" "repair" "failed" "why" nil 1 4 20 0))
        (work (pai-v3.mind::docket-work-prompt "w1" "normal" "title" "purpose" "benefit" "NEXT_STEP" nil 2 20)))
    (is (search "at most two concerns" review))
    (is (search "may be unsaid" review))
    (is (search "when to look again" review))
    (is (search "work_docket" review))
    (is (search "SYNTHETIC_MEMORY" wander)) (is (search "SYNTHETIC_SUMMARY" wander))
    (is (search "reality, memories, relationships and ideas" wander))
    (is (search "making and saving something with document" wander))
    (is (search "SYNTHETIC_QUESTION" concern))
    (is (not (search "A failure" concern)))
    (is (search "notify_operator" concern)) (is (search "draft_forum_post" concern))
    (is (search "A failure, looked at at once" repair))
    (is (search "This is a repair" repair))
    (is (search "NEXT_STEP" work))
    (is (search "Read prior document revisions" work))
    (is (search "not the deliverable" work))))

(run-suite "mind-initiative")
