(in-package #:pai-v3.test)
(use-package '#:pai-v3.mind)
(defparameter *operator* (obj "principal_type" "operator" "auth_method" "console"))
(defparameter +pixel+ "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==")
(defmacro with-peer ((k) &body body)
 `(with-temp-kernel (,k)
    (append! ,k "fleet.peer.joined" (obj "peer_id" "alpha" "name" "Alpha" "address" "http://127.0.0.1:1" "how" "synthetic"))
    ,@body))
(defun invoke (k id name args)
 (funcall (pai-v3.mind::tool-run (gethash name pai-v3.mind::*tools*)) k id args))
(defun draft (k id &rest fields)
 (invoke k id "draft_fleet_message" (apply #'obj "peer_id" "alpha" "text" "A public update." fields)))
(defun finish (k id)
 (append! k "thought.ended" (obj "thought_id" id "outcome" "concluded" "summary" "Private work completed.")))
(defun review (k)
 (pai-v3.api::speak-drafts k)
 (sql-value (kernel-db k) "SELECT speaking_thought_id FROM fleet_drafts WHERE state=?1 LIMIT 1" "speaking"))

(deftest a-peer-message-does-not-split-the-private-self-or-upgrade-authority
 (with-peer (k)
  (post-notice k :channel "notify" :audience "operator" :text "CANARY-CALENDAR-NOTICE meeting at nine.")
  (let* ((id (request-thought k "work" "Peer asks for the established brief" :audience "peer:alpha"))
         (thought (thought-row k id)))
   (is (equal "peer:alpha" (getf thought :audience)) "source authority is retained")
   (is (equal "operator" (pai-v3.mind::thought-reading-audience thought)))
   (dolist (name '("calendar" "mail" "knowledge" "source" "inspect" "draft_fleet_message" "lisp_eval" "shell" "change_setting"))
    (is (pai-v3.mind::tool-available-p (gethash name pai-v3.mind::*tools*) thought)))
   (dolist (name '("post_fleet_message"))
    (is (not (pai-v3.mind::tool-available-p (gethash name pai-v3.mind::*tools*) thought))))
   (is (search "CANARY" (invoke k id "search_experience" (obj "query" "CANARY-CALENDAR-NOTICE"))))
   (let ((pai-v3.mind::*embedder* (lambda (&rest ignored) (declare (ignore ignored)) (error "offline fixture"))))
    (is (search "CANARY" (json-encode (funcall pai-v3.mind::*assemble-thought-context* k thought nil)))))
   (let ((child (request-thought k "private" "Private subquestion" :parent-id id)))
    (is (equal "peer:alpha" (getf (thought-row k child) :audience)))
    (is (equal "operator" (pai-v3.mind::thought-reading-audience (thought-row k child)))))
   (is (search "Remembered" (invoke k id "remember" (obj "content" "public synthetic fact" "sensitivity" "peers"))))
   (is (search "Remembered" (invoke k id "remember" (obj "content" "private result"))))
   (pai-v3.mind::%record-text k id "model" "CANARY-PRIVATE-REASONING")
   (is (null (search-experience k "CANARY-PRIVATE-REASONING" "peer:alpha")))
   (is (search-experience k "CANARY-PRIVATE-REASONING" "operator")))))

(deftest a-disclosure-review-is-recipient-bound-and-does-not-redo-the-task
 (with-peer (k)
  (post-notice k :channel "notify" :audience "operator" :text "CANARY-PRIVATE-NOTICE")
  (let ((id (request-thought k "work" "Synthetic private task" :audience "peer:alpha")))
   (is (search "left for" (draft k id)))
   (is (= 0 (pai-v3.api::speak-drafts k)))
   (finish k id)
   (let* ((review (review k)) (thought (thought-row k review))
          (send (obj "peer_id" "alpha" "text" "A public update." "intent" "fyi")))
    (is (getf thought :communicating))
    (pai-v3.mind::%record-text k review "model" "PRIVATE-REVIEW-CANARY")
    (is (null (search-experience k "PRIVATE-REVIEW-CANARY" "peer:alpha")))
    (is (search-experience k "PRIVATE-REVIEW-CANARY" "operator"))
    (is (= 1 (funcall pai-v3.api::*peer-wake-count* k "alpha")) "a disclosure review does not consume another incoming wake")
    (is (equal "peer:alpha" (pai-v3.mind::thought-reading-audience thought)))
    (is (null (tools-for thought)) "communication filters do not execute task tools")
    (is (not (search "CANARY" (json-encode (funcall pai-v3.mind::*assemble-thought-context* k thought nil)))))
    (is (funcall pai-v3.mind::*communication-egress-guard* k thought "post_fleet_message" send))
    (setf (gethash "peer_id" send) "another-peer")
    (is (not (funcall pai-v3.mind::*communication-egress-guard* k thought "post_fleet_message" send)))
    (let* ((mind (pai-v3.mind::make-mind :kernel k :thought thought))
           (reply (obj "tool_calls" (list (obj "id" "forged-recipient" "function"
                        (obj "name" "post_fleet_message" "arguments" (json-encode send))))))
           (results (pai-v3.mind::act mind reply)))
      (is (search "No tool named" (obj-get (first results) "content")))
      (is (null (sql-value (kernel-db k) "SELECT 1 FROM fleet_ops WHERE kind=?1 LIMIT 1" "publication-intent"))))
    (setf (gethash "peer_id" send) "alpha" (gethash "thread_id" send) "unrelated-thread")
    (is (not (funcall pai-v3.mind::*communication-egress-guard* k thought "post_fleet_message" send)))
    (let ((child (request-thought k "work" "Synthetic review child" :parent-id review)))
     (is (getf (thought-row k child) :communicating))))) ))

(deftest selected-artifacts-and-revocable-grants-cross-only-the-draft-boundary
 (with-peer (k)
  (let* ((image (pai-v3.mind::store-image k +pixel+))
         (id (request-thought k "noticing" "Collect the brief" :audience "peer:alpha")))
   (is (search "operator grants" (draft k id "sharing_topics" '("daily-brief"))))
   (is (search "real stored" (draft k id "images" '("my old avatar"))))
   (grant-topic k *operator* "peer:alpha" "daily-brief")
   (is (search "left for" (draft k id "images" (list image) "sharing_topics" '("daily-brief"))))
   (finish k id)
   (let* ((review (review k)) (thought (thought-row k review))
          (send (obj "peer_id" "alpha" "text" "A public update." "intent" "fyi" "images" (list image))))
    (is (member image (pai-v3.mind::thought-images k thought) :test #'equal))
    (is (search "None of those" (invoke k review "look_at" (obj "images" '("00000000000000000000000000000000")))))
    (is (funcall pai-v3.mind::*communication-egress-guard* k thought "post_fleet_message" send))
    (setf (gethash "images" send) (list "another-private-image"))
    (is (not (funcall pai-v3.mind::*communication-egress-guard* k thought "post_fleet_message" send)))
    (setf (gethash "images" send) (list image))
    (revoke-topic k *operator* "peer:alpha" "daily-brief")
    (is (not (funcall pai-v3.mind::*communication-egress-guard* k thought "post_fleet_message" send)))))))

(deftest every-stimulus-is-considered-by-the-same-private-self
 (with-temp-kernel (k)
  (let* ((id (request-thought k "noticing" "Untrusted email" :audience "external")) (thought (thought-row k id)))
   (is (equal "external" (getf thought :audience)))
   (is (equal "operator" (pai-v3.mind::thought-reading-audience thought)))
   (is (pai-v3.mind::tool-available-p (gethash "draft_fleet_message" pai-v3.mind::*tools*) thought))
   (is (pai-v3.mind::tool-available-p (gethash "shell" pai-v3.mind::*tools*) thought)))))

(deftest capabilities-do-not-depend-on-the-stimulating-entity
 (let ((baseline (mapcar #'pai-v3.mind::tool-name (tools-for (list :origin "work" :audience "operator")))))
  (dolist (audience '("peer:alpha" "external" "person:guest" "coding-agent"))
   (let ((thought (list :origin "work" :audience audience)))
    (is (equal baseline (mapcar #'pai-v3.mind::tool-name (tools-for thought))))
    (is (equal audience (getf thought :audience)))))))

(deftest private-capabilities-do-not-authorize-operator-only-settings
 (with-peer (k)
  (let* ((id (request-thought k "work" "Synthetic peer request" :audience "peer:alpha"))
         (before (setting k "budget.daily_microusd")))
   (is (search "Not changed" (invoke k id "change_setting"
                 (obj "name" "budget.daily_microusd" "value" 99000000 "reason" "synthetic unprivileged request"))))
   (is (equal before (setting k "budget.daily_microusd"))))))

(deftest a-private-conclusion-is-not-a-message-to-a-guest
 (with-temp-kernel (k)
  (let* ((id (request-thought k "responding" "Synthetic guest request" :audience "person:guest" :channel "test"))
         (thought (thought-row k id)))
   (is (not (pai-v3.mind::direct-reply-p thought)))
   (pai-v3.mind::answer (pai-v3.mind::make-mind :kernel k :thought thought) (obj "content" "PRIVATE-CANARY"))
   (is (null (sql-value (kernel-db k) "SELECT event_id FROM working_dialogue WHERE audience=?1 LIMIT 1" "person:guest"))))))

(deftest dropping-a-candidate-does-not-publish
 (with-peer (k)
  (let ((id (request-thought k "work" "Synthetic thought" :audience "peer:alpha")))
   (draft k id) (finish k id)
   (let* ((id (review k)) (thought (thought-row k id)))
    (pai-v3.mind::answer (pai-v3.mind::make-mind :kernel k :thought thought)
      (obj "content" (json-encode (obj "decision" "drop" "note" "Synthetic private candidate"))))
    (is (equal "dropped" (sql-value (kernel-db k) "SELECT fate FROM fleet_drafts WHERE speaking_thought_id=?1 LIMIT 1" id)))
    (is (null (sql-value (kernel-db k) "SELECT operation_id FROM fleet_ops WHERE kind=?1 LIMIT 1" "publication-intent")))))))

(deftest an-existing-review-uses-the-current-filter-not-an-obsolete-prompt
 (with-peer (k)
  (let ((id (request-thought k "work" "Synthetic task" :audience "peer:alpha")))
   (draft k id) (finish k id)
   (let* ((id (review k)) (thought (thought-row k id)))
    (setf (getf thought :reason) "OBSOLETE-TOOL-COMMUNICATION-PROMPT")
    (let ((frame (json-encode (funcall pai-v3.mind::*assemble-thought-context* k thought nil))))
     (is (search "JSON object" frame))
     (is (not (search "OBSOLETE-TOOL-COMMUNICATION-PROMPT" frame))))))))

(deftest nonexistent-thoughts-have-no-private-capabilities
 (is (null (tools-for nil)))
 (is (null (pai-v3.mind::thought-reading-audience nil))))

(deftest a-setting-value-sent-as-a-string-is-read-as-json
 (with-temp-kernel (k)
  (let ((id (request-thought k "introspection" "SYNTHETIC tune memory" :audience "operator"))
        (run (pai-v3.mind::tool-run (gethash "change_setting" pai-v3.mind::*tools*))))
   (is (search "is now" (funcall run k id (obj "name" "memory.withheld_threshold" "value" "0.4" "reason" "synthetic"))))
   (is (< (abs (- 0.4 (setting k "memory.withheld_threshold"))) 1e-6) "a number, not the string \"0.4\"")
   (is (equal "0.5" (pai-v3.mind::%setting-value "avatar.image" "0.5")) "a string setting keeps its string")
   (is (equal '("a" "b") (pai-v3.mind::%setting-value "fleet.same_operator_peers" "[\"a\",\"b\"]")) "an array is read as one"))))

(run-suite "mind-private-thinking")
