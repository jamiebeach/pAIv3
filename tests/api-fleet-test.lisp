```"
                                    "Not JSON at all.")))
               (sql-row (kernel-db a) "SELECT state,fate,note FROM fleet_drafts WHERE speaking_thought_id=?1 LIMIT 1" r))))
      (is (equal '("settled" "edited") (subseq (review "SYNTHETIC-WRAPPED") 0 2)) "JSON inside prose or fences is read")
      (is (sql-value (kernel-db b) "SELECT 1 FROM board_messages WHERE text=?1 LIMIT 1" "SYNTHETIC-WRAPPED-SENT"))
      (let ((row (review "SYNTHETIC-UNREADABLE")))
        (is (equal '("settled" "dropped") (subseq row 0 2)) "an unreadable answer drops the draft instead of stranding it")
        (is (search "not readable" (third row)))))))))

(deftest restricted-publication-is-enforced-on-the-receiving-board
 (with-two-agents (a b)
  (join a b)
  (let* ((bid (pai-v3.api::fleet-agent-id b))
         (image (pai-v3.mind::store-image a +tiny-png+)))
   (multiple-value-bind (said thread message)
       (pai-v3.api::fleet-post a bid "SYNTHETIC-PRIVATE-COMMUNICATION" :restricted t :images (list image))
    (declare (ignore message))
    (is (search "Posted" said))
    (is (pai-v3.api::board-thread-json b thread))
    (is (pai-v3.api::board-image b thread image))
    (is (search "SYNTHETIC-PRIVATE" (json-encode
          (pai-v3.api::%fleet-http a (address *port-b*) (format nil "/board/thread?id=~a" thread) nil :peer-id bid :method :get))))
    (with-temp-kernel (c)
     (fleet-setup c "Gamma" (+ *port-a* 2))
     (let ((cid (pai-v3.api::fleet-agent-id c))
           (key "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"))
      (pai-v3.api::%keep-peer b cid "Gamma" (address (+ *port-a* 2)) key "synthetic")
      (pai-v3.api::%keep-peer c bid "Alpha" (address *port-b*) key "synthetic")
      (flet ((get-shared (path) (pai-v3.api::%fleet-http c (address *port-b*) path nil :peer-id bid :method :get)))
       (is (null (obj-get (get-shared "/board/threads") "threads")))
       (is (null (obj-get (get-shared "/board/since?ts=0") "messages")))
       (signals error (get-shared (format nil "/board/thread?id=~a" thread)))
       (signals error (get-shared (format nil "/board/image?thread=~a&id=~a" thread image)))
       (is (null (pai-v3.api::board-image b thread image :peer cid))))))))))

(deftest restricted-publication-fails-before-sending-to-an-old-peer
 (with-temp-kernel (k)
  (append! k "fleet.peer.joined" (obj "peer_id" "old" "name" "Old" "address" "http://127.0.0.1:1" "how" "synthetic"))
  (let ((original (symbol-function 'pai-v3.api::%fleet-http)) (calls nil))
   (unwind-protect
    (progn
     (setf (symbol-function 'pai-v3.api::%fleet-http)
           (lambda (kernel address path payload &key peer-id method)
            (declare (ignore kernel address peer-id))
            (push (list path payload method) calls)
            (obj "threads" nil)))
     (is (search "nothing private was sent" (pai-v3.api::%tool-text
           (lambda () (pai-v3.api::fleet-post k "old" "SYNTHETIC-PRIVATE" :restricted t)))))
     (is (= 1 (length calls)))
     (is (equal "/board/threads" (first (first calls))))
     (is (null (second (first calls))))
     (is (eq :get (third (first calls)))))
    (setf (symbol-function 'pai-v3.api::%fleet-http) original)))))

(deftest a-peer-of-the-same-operator-may-hear-what-the-operator-may
 (with-two-agents (a b)
  (join a b)
  (let ((peer (pai-v3.api::fleet-agent-id b)))
   (flet ((prompt () (pai-v3.api::%speaking-prompt a peer "d-x" nil nil "fyi" "Synthetic text")))
    (is (not (pai-v3.api::same-operator-peer-p a peer)))
    (is (search "not marked as sharing your operator" (prompt)))
    (is (search "Attachments supplied with this candidate: none." (prompt)) "no Lisp NIL in the prompt")
    (is (search "never a reason to drop" (prompt)) "the review judges disclosure, not wording")
    (change-setting a "fleet.same_operator_peers" (list (second (pai-v3.api::fleet-peer a peer))) :origin *operator*)
    (is (pai-v3.api::same-operator-peer-p a peer) "marked by name")
    (is (search "same operator" (prompt)))
    (is (search "calendar, mail" (prompt)))
    (is (search "Never disclose credentials" (prompt)))))))

(deftest a-draft-with-half-a-reply-route-is-refused-when-staged
  (with-two-agents (a b)
    (join a b)
    (let ((peer (pai-v3.api::fleet-agent-id a))
          (reflection (request-thought b "introspection" "SYNTHETIC reflection"))
          (tool (pai-v3.mind::tool-run (gethash "draft_fleet_message" *tools*))))
      (is (search "together" (funcall tool b reflection (obj "peer_id" peer "text" "Hi." "thread_id" "3779971b-6f84-4047-b8c9-0346751dae19"))))
      (is (search "together" (funcall tool b reflection (obj "peer_id" peer "text" "Hi." "reply_to" "3779971b-6f84-4047-b8c9-0346751dae19"))))
      (is (search "full id" (funcall tool b reflection (obj "peer_id" peer "text" "Hi." "thread_id" "20820b2a" "reply_to" "3779971b-6f84-4047-b8c9-0346751dae19"))))
      (is (search "left for" (funcall tool b reflection (obj "peer_id" peer "text" "Hi." "thread_id" "3779971b-6f84-4047-b8c9-0346751dae19"
                                                             "reply_to" "4779971b-6f84-4047-b8c9-0346751dae19")))))))

(deftest the-operators-fleet-view-shows-posts-restricted-to-another-sister
  (with-two-agents (a b)
    (join a b)
    (let* ((b-id (pai-v3.api::fleet-agent-id b))
           (a-id (pai-v3.api::fleet-agent-id a)))
      (pai-v3.api::fleet-post a b-id "SYNTHETIC open post")
      (let ((thread (first (first (pai-v3.api::board-threads b)))))
        ;; A post on B's board disclosed to some other sister only.
        (multiple-value-bind (msg) (pai-v3.api::board-post b :thread-id thread :author-id "sister-c" :author-name "C"
                                                             :text "SYNTHETIC for B only" :scope "pairwise" :operation-id "op-r"
                                                             :request-key "r" :visibility-peer "sister-c")
          (declare (ignore msg)))
        (flet ((texts () (mapcar (lambda (m) (obj-get m "text")) (obj-get (pai-v3.api::fleet-board-thread a b-id thread) "messages"))))
          (is (not (member "SYNTHETIC for B only" (texts) :test #'equal)) "hidden from a sister not marked as the same operator's")
          (change-setting b "fleet.same_operator_peers" (list a-id) :origin *operator*)
          (is (member "SYNTHETIC for B only" (texts) :test #'equal) "the operator sees it through any sister of theirs")
          (let ((tool (pai-v3.api::read-peer-board a b-id thread "operator")))
            (is (not (search "SYNTHETIC for B only" tool)) "the agent's own reading stays restricted")))))))

(deftest reactions-toggle-travel-to-the-owning-board-and-wake-nobody
  (with-two-agents (a b)
    (join a b)
    (let* ((b-id (pai-v3.api::fleet-agent-id b))
           (a-id (pai-v3.api::fleet-agent-id a)))
      (change-setting b "fleet.same_operator_peers" (list a-id) :origin *operator*)
      (pai-v3.api::fleet-post a b-id "SYNTHETIC react to me" :intent "fyi")
      (let* ((thread (first (first (pai-v3.api::board-threads b))))
             (msg (first (first (pai-v3.api::board-messages b thread))))
             (woken (length (peer-thoughts b a))))
        (is (search "one emoji" (pai-v3.api::%tool-text (lambda () (pai-v3.api::react b "self" msg "lol")))) "only an emoji")
        (is (eq t (pai-v3.api::react b "self" msg "👍" :operator t)) "the operator, on this board")
        (is (null (pai-v3.api::react a b-id msg "👍" :operator t)) "the same person through another agent: toggled off")
        (is (eq t (pai-v3.api::react a b-id msg "👍" :operator t)) "and on again")
        (is (eq t (pai-v3.api::react a b-id msg "👍")) "the agent's own reaction, carried there")
        (let ((r (first (pai-v3.api::board-reactions b msg))))
          (is (= 2 (obj-get r "count")) "the operator once, the sister once")
          (is (member "operator" (obj-get r "by_ids") :test #'equal)))
        (is (null (pai-v3.api::react a b-id msg "👍" :operator t)) "the operator takes it back through either agent")
        (is (= 1 (obj-get (first (pai-v3.api::board-reactions b msg)) "count")))
        (is (search "[reactions: 👍" (pai-v3.api::%board-text b thread)) "the owner reads reactions")
        (is (search "[reactions: 👍" (pai-v3.api::read-peer-board a b-id thread "operator")) "and so does a sister")
        (is (search "Reacted" (funcall (pai-v3.mind::tool-run (gethash "react_to_board_post" *tools*)) b
                                       (request-thought b "work" "SYNTHETIC" :audience "operator")
                                       (obj "msg_id" msg "emoji" "🎉"))))
        (is (= woken (length (peer-thoughts b a))) "no reaction woke anyone")
        (is (= 2 (length (obj-get (first (obj-get (pai-v3.api::board-thread-json b thread) "messages")) "reactions")))
            "the board page sees them")))))

