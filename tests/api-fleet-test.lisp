(in-package #:pai-v3.test)
(use-package '#:pai-v3.mind)
(use-package '#:pai-v3.api)

;;; The fleet in v2's protocol (bead v3-clp.12): two agents in this process,
;;; each on its own port, join with an operator-typed code, then talk through
;;; their own boards with signed requests.

(defparameter *operator* (obj "principal_type" "operator" "auth_method" "passkey"))
(defvar *port-a* (+ 45000 (random 2000)))
(defvar *port-b* (+ 47000 (random 2000)))
(defvar *next-fleet-test-port* 44000)

(defun address (port) (format nil "http://127.0.0.1:~d" port))

(defun fleet-setup (k name port)
  (change-setting k "fleet.enabled" t :origin *operator*)
  (change-setting k "fleet.own_name" name :origin *operator*)
  (change-setting k "fleet.own_address" (address port) :origin *operator*))

(defmacro with-two-agents ((a b) &body body)
  `(let ((secrets (db-open (format nil "/tmp/pai-v3-fleet-secrets-~d.db" (random 100000000)) :key *test-key*)))
     (pai-v3.trust:open-secrets secrets)
     ;; Never reuse a port in this process: random selection can collide with
     ;; another fixture's closing listener or pooled connection.
     (setf *port-a* (incf *next-fleet-test-port* 2) *port-b* (1+ *port-a*))
     (unwind-protect
          (with-temp-kernel (,a :agent-id "beta")
            (with-temp-kernel (,b :agent-id "alpha")
              (fleet-setup ,a "Beta" *port-a*)
              (fleet-setup ,b "Alpha" *port-b*)
              (let ((agent-a (start-agent ,a :port *port-a* :address "127.0.0.1"))
                    (agent-b (start-agent ,b :port *port-b* :address "127.0.0.1")))
                (unwind-protect (progn ,@body)
                  (stop-agent agent-a)
                  (stop-agent agent-b)))))
       (pai-v3.trust:close-secrets)
       (db-close secrets))))

(defun join (a b)
  "A asks B; B's operator types the code from A's screen."
  (let* ((said (pai-v3.api::fleet-request a (address *port-b*)))
         (code (subseq said (+ 13 (search "Your code is " said)) (+ 19 (search "Your code is " said)))))
    (pai-v3.api::fleet-approve b (pai-v3.api::fleet-agent-id a) code)))

(defun peer-thoughts (k peer-k)
  (sql-rows (kernel-db k) "SELECT id,reason FROM thoughts WHERE audience=?1 ORDER BY id LIMIT 50"
            (format nil "peer:~a" (pai-v3.api::fleet-agent-id peer-k))))

(deftest joining-needs-the-right-code
  (with-two-agents (a b)
    (pai-v3.api::fleet-request a (address *port-b*))
    (is (search "code does not match"
                (handler-case (pai-v3.api::fleet-approve b (pai-v3.api::fleet-agent-id a) "000000x")
                  (pai-v3.api::board-error (e) (pai-v3.api::board-error-reason e)))))
    (is (null (pai-v3.api::fleet-peers b)) "no peer on a wrong code")
    (is (search "is now a fleet peer" (join a b)))
    (is (equal "Beta" (second (first (pai-v3.api::fleet-peers b)))))
    (is (equal "Alpha" (second (first (pai-v3.api::fleet-peers a)))) "both sides hold the peer")
    (is (null (search (pai-v3.api::fleet-agent-id a)
                      (or (sql-value (kernel-db b) "SELECT group_concat(event_json) FROM pai_events WHERE agent_id=?1 AND event_type=?2 LIMIT 1"
                                     "alpha" "nothing") "")))
        "sanity")
    (is (null (search "shared_secret" (sql-value (kernel-db b) "SELECT event_json FROM pai_events WHERE agent_id=?1 AND event_type=?2 ORDER BY storage_sequence DESC LIMIT 1"
                                                 "alpha" "fleet.peer.joined")))
        "the secret is never in the ledger")))

(deftest a-signed-post-lands-on-the-board-and-wakes-a-peer-thought
  (with-two-agents (a b)
    (join a b)
    (let ((b-id (pai-v3.api::fleet-agent-id b)))
      (is (search "Posted to Alpha's board" (pai-v3.api::fleet-post a b-id "Have you read the new chapter?")))
      (let ((thread (first (first (pai-v3.api::board-threads b)))))
        (is thread "a thread on Alpha's board")
        (is (equal "Have you read the new chapter?" (fourth (first (pai-v3.api::board-messages b thread)))))
        (is (equal "Beta" (third (first (pai-v3.api::board-messages b thread)))) "the author is the verified peer")
        (is (= 1 (length (peer-thoughts b a))) "Alpha considers it as a peer thought")
        (is (search "no operator authority" (second (first (peer-thoughts b a)))))
        (is (search "Have you read the new chapter?" (second (first (peer-thoughts b a))))
            "the woken thought is given the post's own text")
        (is (null (search "NIL" (second (first (peer-thoughts b a))))))
        (is (sql-value (kernel-db b) "SELECT 1 FROM working_dialogue WHERE kind=?1 LIMIT 1" "notice") "Alpha's operator is told")
        (pai-v3.api::fleet-post a b-id "And the ending?")
        (is (= 1 (length (pai-v3.api::board-threads b))) "later posts continue the thread")
        (is (= 2 (length (pai-v3.api::board-messages b thread))))
        ;; Alpha replies on its own board; Beta is told.
        (let ((first-msg (first (first (pai-v3.api::board-messages b thread)))))
          (is (search "Beta was told" (pai-v3.api::fleet-reply b thread first-msg "Yes, last night.")))
          (is (= 0 (length (peer-thoughts a b))) "an answer is told but wakes nobody")
          (pai-v3.api::fleet-reply b thread first-msg "Did you like the ending?" :intent "question")
          (is (= 1 (length (peer-thoughts a b))) "a question wakes Beta")
          (is (search "Did you like the ending?" (second (first (peer-thoughts a b)))))
          (is (search "absorb" (string-downcase (second (first (peer-thoughts a b))))) "asked to decide"))))))

(defparameter +tiny-png+
  "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==")

(deftest images-travel-with-board-messages
  (with-two-agents (a b)
    (join a b)
    (let* ((b-id (pai-v3.api::fleet-agent-id b))
           (mine (pai-v3.mind::store-image a +tiny-png+)))
      (is (search "no stored image" (pai-v3.api::%tool-text (lambda () (pai-v3.api::fleet-post a b-id "look" :images (list "0123456789abcdef0123456789abcdef")))))
          "only images I hold can be sent")
      (is (search "Posted to Alpha's board" (pai-v3.api::fleet-post a b-id "My new portrait." :images (list mine))))
      (let* ((thread (first (first (pai-v3.api::board-threads b))))
             (message (first (pai-v3.api::board-messages b thread)))
             (theirs (pai-v3.api::board-message-images b (tenth message))))
        (is (equal (list mine) theirs) "the receiver keeps its own copy, under the same content id")
        (is (equal "image/png" (first (pai-v3.mind::image-row b mine))) "in its own store")
        (is (search "with 1 image" (second (first (peer-thoughts b a)))) "the woken thought is told")
        (is (equal (list mine) (pai-v3.mind::turn-images b (thought-row b (first (first (peer-thoughts b a))))))
            "and sees it")
        (is (equal (list mine) (obj-get (first (obj-get (pai-v3.api::board-thread-json b thread) "messages")) "images"))
            "the operator's board page shows it")
        (is (null (search "base64" (sql-value (kernel-db b) "SELECT event_json FROM pai_events WHERE agent_id=?1 AND event_type=?2 ORDER BY storage_sequence DESC LIMIT 1"
                                              "alpha" "fleet.board.posted")))
            "the ledger holds the id, never the picture")
        ;; A reply with an image: the notification carries it to the peer.
        (progn
          (is (search "Beta was told" (pai-v3.api::fleet-reply b thread (first message) "Here is mine." :images (list mine) :intent "question")))
          (is (equal (list mine) (pai-v3.mind::turn-images a (thought-row a (first (first (peer-thoughts a b))))))
              "a reply's images reach the peer it tells"))
        (pai-v3.api::fleet-post a b-id (format nil "Linked only:~%![me](/api/v2/images/~a)" mine) :thread-id thread :reply-to (first message))
        (is (equal (list mine) (pai-v3.api::board-message-images
                                b (tenth (car (last (pai-v3.api::board-messages b thread))))))
            "an image my text links to travels as an attachment")))))

(deftest the-fleet-view-reads-every-board
  (with-two-agents (a b)
    (join a b)
    (let* ((b-id (pai-v3.api::fleet-agent-id b))
           (mine (pai-v3.mind::store-image a +tiny-png+))
           (private (pai-v3.mind::store-image b (concatenate 'string (subseq +tiny-png+ 0 (- (length +tiny-png+) 8)) "AAAAAAA=")))
           (thread (progn (pai-v3.api::fleet-post a b-id "Look at this." :images (list mine))
                          (first (first (pai-v3.api::board-threads b))))))
      (declare (ignorable private))
      ;; A peer that cannot be reached: known, but with no address that answers.
      (append! a "fleet.peer.joined" (obj "peer_id" "gone-peer" "name" "Gone" "address" "http://127.0.0.1:1" "how" "approved"))
      (let* ((boards (pai-v3.api::fleet-board-overview a))
             (alpha (find b-id boards :key (lambda (x) (obj-get x "owner")) :test #'equal))
             (gone (find "gone-peer" boards :key (lambda (x) (obj-get x "owner")) :test #'equal)))
        (is (equal "self" (obj-get (first boards) "owner")) "my own board first")
        (is (eq t (obj-get alpha "reachable")))
        (is (equal "Look at this." (obj-get (first (obj-get alpha "threads")) "preview")) "the peer's board, as forum rows")
        (is (eq :false (obj-get gone "reachable")) "a peer that cannot be reached is shown as such")
        (is (stringp (obj-get gone "error"))))
      (let ((detail (pai-v3.api::fleet-board-thread a b-id thread)))
        (is (equal (list mine) (obj-get (first (obj-get detail "messages")) "images")) "a thread on the peer's board, with its images"))
      (is (equal "image/png" (first (pai-v3.api::fleet-board-image a b-id thread mine))) "the image, fetched from the peer")
      (is (null (pai-v3.api::fleet-board-image a b-id thread private))
          "an image not attached to that thread is never served"))))

(deftest a-sisters-picture-is-fetched-once-and-remembered
  (with-two-agents (a b)
    (join a b)
    (let ((b-id (pai-v3.api::fleet-agent-id b)))
      (clrhash pai-v3.api::*peer-avatars*)
      (is (null (pai-v3.api::avatar-for a b-id)) "she has none: the page keeps the letter")
      (clrhash pai-v3.api::*peer-avatars*)
      (change-setting b "avatar.image" (pai-v3.mind::store-image b +tiny-png+) :origin (obj "principal_type" "self"))
      (multiple-value-bind (mime octets) (pai-v3.api::avatar-for a b-id)
        (is (equal "image/png" mime) "fetched from her over the signed route")
        (is (plusp (length octets))))
      ;; Remembered: she can change it and a board page asks again within the minutes without reaching her.
      (change-setting b "avatar.image" "" :origin (obj "principal_type" "self"))
      (is (equal "image/png" (pai-v3.api::avatar-for a b-id)) "the earlier answer is kept for a few minutes")
      (clrhash pai-v3.api::*peer-avatars*)
      (is (null (pai-v3.api::avatar-for a b-id)) "and forgotten after, so her change shows")
      ;; "She has none" is believed only briefly: a page loaded before she chose must not hide her picture.
      (change-setting b "avatar.image" (pai-v3.mind::store-image b +tiny-png+) :origin (obj "principal_type" "self"))
      (is (null (pai-v3.api::avatar-for a b-id)) "within the moment, the miss is still believed")
      (let ((pai-v3.api::*peer-avatar-none-seconds* 0))
        (is (equal "image/png" (pai-v3.api::avatar-for a b-id)) "after it, her new picture shows"))
      (change-setting b "avatar.image" "" :origin (obj "principal_type" "self"))
      (clrhash pai-v3.api::*peer-avatars*)
      (is (null (pai-v3.api::avatar-for a "not-a-peer")) "a stranger has none")
      ;; Mine, by either name.
      (change-setting a "avatar.image" (pai-v3.mind::store-image a +tiny-png+) :origin (obj "principal_type" "self"))
      (is (equal "image/png" (pai-v3.api::avatar-for a "self")))
      (is (equal "image/png" (pai-v3.api::avatar-for a (pai-v3.api::fleet-agent-id a))) "my own id is me"))))

(deftest an-agent-reads-a-sisters-board-uninvited
  (with-two-agents (a b)
    (join a b)
    (let* ((picture (pai-v3.mind::store-image b +tiny-png+))
           (said (pai-v3.api::fleet-announce b "My new portrait, for anyone curious." :title "Portrait" :images (list picture)))
           (thread (first (first (pai-v3.api::board-threads b)))))
      (declare (ignore said))
      (is (null (pai-v3.mind::image-row a picture)) "untagged, nothing reached Beta")
      (let ((listing (pai-v3.api::read-peer-board a "Alpha" nil "operator")))
        (is (search "Alpha's board:" listing) "a peer is named by name")
        (is (search "Portrait" listing)))
      (let ((text (pai-v3.api::read-peer-board a "Alpha" thread "operator")))
        (is (search "My new portrait" text))
        (is (search picture text) "with its image id")
        (is (search "post_fleet_message" text) "and how to answer there"))
      (is (equal "image/png" (first (pai-v3.mind::image-row a picture))) "the picture is now in Beta's own store")
      (is (search picture (format nil "~{~a~}" (mapcar #'first (pai-v3.mind::recently-seen a "operator"))))
          "and among what she has seen lately, so she can look_at it")
      (is (search "no peer called" (pai-v3.api::%tool-text (lambda () (pai-v3.api::read-peer-board a "Nobody" nil "operator"))))))))

(deftest the-operator-posts-to-the-group
  (with-two-agents (a b)
    (join a b)
    (change-setting b "operator.name" "Sam" :origin *operator*)
    (let* ((r (pai-v3.api::operator-post b "Dinner is at seven; who is in?" :title "Dinner" :tell :all))
           (thread (obj-get r "thread_id"))
           (message (first (pai-v3.api::board-messages b thread))))
      (is (equal "Sam" (third message)) "the post is the operator's, by name")
      (is (equal '("Beta") (obj-get r "told")) "every peer is told")
      (is (search "the operator, posted on my board" (second (first (sql-rows (kernel-db b) "SELECT id,reason FROM thoughts WHERE audience=?1 ORDER BY id DESC LIMIT 1" "operator"))))
          "the owner wakes, with the operator's authority")
      (let ((told (second (first (peer-thoughts a b)))))
        (is (search "Sam, the operator, posted on Alpha's board" told) "a peer hears whose words they are")
        (is (search "carries no operator authority" told) "relayed, never with authority"))
      (is (search "a new thread needs a title"
                  (pai-v3.api::%tool-text (lambda () (pai-v3.api::operator-post b "x")))))
      (let ((again (pai-v3.api::operator-post b "Me too." :thread-id thread :reply-to (first message))))
        (is (= 2 (length (pai-v3.api::board-messages b thread))) "and replies in the thread")
        (is (null (obj-get again "told")) "telling no one unless asked")))))

(deftest the-operator-replies-on-a-sisters-board-through-their-agent
  (with-two-agents (a b)
    (join a b)
    (change-setting a "operator.name" "Sam" :origin *operator*)
    (let* ((b-id (pai-v3.api::fleet-agent-id b))
           (posts-before (pai-v3.api::%posts-today a))
           (r (pai-v3.api::operator-post a "Can someone water the plants?" :title "Plants" :owner b-id))
           (thread (obj-get r "thread_id"))
           (first-post (first (pai-v3.api::board-messages b thread))))
      (is (equal "Sam (via Beta)" (third first-post)) "on Alpha's board, under the operator's name, carried by Beta")
      (let ((woken (second (first (peer-thoughts b a)))))
        (is (search "Sam, the operator, posted on your board through Beta" woken))
        (is (search "carries no operator authority" woken) "relayed, never with authority"))
      (is (search "Sam, the operator, posted on Alpha's board through me"
                  (second (first (sql-rows (kernel-db a) "SELECT id,reason FROM thoughts WHERE audience=?1 ORDER BY id DESC LIMIT 1" "operator"))))
          "the carrier wakes too, with the operator's authority: the post is often addressed to her")
      (is (= posts-before (pai-v3.api::%posts-today a)) "the operator's posts are not Beta's own allowance")
      (pai-v3.api::operator-post a "Thanks!" :owner b-id :thread-id thread :reply-to (first first-post))
      (is (= 2 (length (pai-v3.api::board-messages b thread))) "and a reply in place")
      (is (search "which message" (pai-v3.api::%tool-text (lambda () (pai-v3.api::operator-post a "x" :owner b-id :thread-id thread))))))))

(deftest a-chain-too-deep-wakes-nobody
  (with-two-agents (a b)
    (join a b)
    (let ((b-id (pai-v3.api::fleet-agent-id b)))
      (pai-v3.api::fleet-post a b-id "deep" :chain-depth 4)
      (is (= 0 (length (peer-thoughts b a))) "past the depth cap it is kept but wakes nobody")
      (is (search "not woken: its chain is 4 replies deep"
                  (sql-value (kernel-db b) "SELECT rendered FROM working_dialogue WHERE kind=?1 ORDER BY event_id DESC LIMIT 1" "notice")))
      (pai-v3.api::fleet-post a b-id "shallow" :chain-depth 2)
      (let ((thought (first (first (peer-thoughts b a)))))
        (is thought)
        (is (= 3 (pai-v3.api::%outgoing-depth b thought)) "an answer from that thought goes one deeper")))))

(deftest tagging-a-peer-tells-it
  (with-two-agents (a b)
    (join a b)
    (let ((a-id (pai-v3.api::fleet-agent-id a)))
      (is (search "Told Beta" (pai-v3.api::fleet-announce b "Anyone know a good fantasy map tool?" :tags (list a-id) :intent "question")))
      (is (search "tagged me" (funcall (pai-v3.mind::tool-run (gethash "read_fleet_board" pai-v3.mind::*tools*)) a nil (obj)))
          "a tag can be found again: it lives on the peer's board, not mine")
      (is (search "good fantasy map tool" (funcall (pai-v3.mind::tool-run (gethash "read_fleet_board" pai-v3.mind::*tools*)) a nil (obj))))
      (is (= 1 (length (peer-thoughts a b))))
      (is (search "tagged you" (second (first (peer-thoughts a b)))))
      (pai-v3.api::fleet-announce b "The maps are done." :tags (list a-id))
      (is (= 1 (length (peer-thoughts a b))) "a tagged fyi is told but wakes nobody")
      (is (search "not one of my peers" (pai-v3.api::%tool-text (lambda () (pai-v3.api::fleet-announce b "x" :tags (list "nobody")))))))))

(deftest a-resolved-thread-takes-no-more
  (with-two-agents (a b)
    (join a b)
    (pai-v3.api::fleet-post a (pai-v3.api::fleet-agent-id b) "Done with this?")
    (let ((thread (first (first (pai-v3.api::board-threads b)))))
      (is (search "Resolved" (pai-v3.api::fleet-resolve b thread)))
      (is (search "resolved" (pai-v3.api::%tool-text (lambda () (pai-v3.api::fleet-post a (pai-v3.api::fleet-agent-id b) "One more thing"))))
          "a post to a resolved thread is refused"))))

(deftest the-digest-reads-what-the-crew-posted-once
  (with-two-agents (a b)
    (join a b)
    (change-setting a "fleet.same_operator_peers" (list "Alpha") :origin *operator*)
    (change-setting b "fleet.same_operator_peers" (list "Beta") :origin *operator*)
    (pai-v3.api::forum-post a :title "Books" :text "I finished reading Dune today." :intent "fyi"
                              :author-id (pai-v3.api::fleet-agent-id a) :author-name "Beta")
    (let ((thought (pai-v3.api::fleet-digest b)))
      (is thought "a digest thought")
      (is (search "I finished reading Dune today." (getf (thought-row b thought) :reason)))
      (is (equal "reflection" (getf (thought-row b thought) :origin)) "thinking to itself, not speaking")
      (is (equal "operator" (getf (thought-row b thought) :audience))
          "so it may know what the agent knows, her own recent acts included")
      (is (search "draft_forum_post" (getf (thought-row b thought) :reason)) "and is told to leave a draft, not post"))
    (is (null (pai-v3.api::fleet-digest b)) "not due again yet")
    (change-setting b "fleet.digest_minutes" 0 :origin *operator*)
    (is (null (pai-v3.api::fleet-digest b)) "off at 0")))

;;; Reflect, then speak (docs/reflect-then-speak.md)

(deftest a-reflection-cannot-publish
  (let ((post (gethash "post_fleet_message" pai-v3.mind::*tools*))
        (reply (gethash "reply_fleet_board_message" pai-v3.mind::*tools*))
        (board (gethash "post_fleet_board" pai-v3.mind::*tools*))
        (draft (gethash "draft_forum_post" pai-v3.mind::*tools*))
        (notify (gethash "notify_operator" pai-v3.mind::*tools*)))
    (dolist (tool (list post reply board))
      (is (not (pai-v3.mind::tool-available-p tool '(:origin "reflection" :audience "operator"))) "no publishing while reflecting")
      (is (not (pai-v3.mind::tool-available-p tool '(:origin "responding" :audience "operator"))) "operator cognition drafts too")
      (is (not (pai-v3.mind::tool-available-p tool '(:origin "work" :audience "peer:x"))) "peer-triggered cognition drafts too"))
    (is (pai-v3.mind::tool-available-p draft '(:origin "reflection" :audience "operator")))
    (is (pai-v3.mind::tool-available-p notify '(:origin "reflection" :audience "operator")) "the operator may hear anything")))

(deftest a-draft-sends-nothing-and-is-said-for-its-peer-afterwards
  (with-two-agents (a b)
    (join a b)
    (let* ((a-id (pai-v3.api::fleet-agent-id a))
           (reflection (request-thought b "reflection" "thinking about the board" :audience "operator"))
           (draft (lambda (thought &rest args)
                    (funcall (pai-v3.mind::tool-run (gethash "draft_fleet_message" pai-v3.mind::*tools*)) b thought (apply #'obj args))))
           (posts-before (length (pai-v3.api::board-threads a))))
      (is (search "left for" (funcall draft reflection "peer_id" a-id "text" "Happy to share the map notes." "intent" "answer"
                                      "why" "PRIVATE-REASON the operator told me X")))
      (is (= posts-before (length (pai-v3.api::board-threads a))) "nothing reached the peer's board")
      (is (null (sql-value (kernel-db b) "SELECT 1 FROM pai_events WHERE agent_id=?1 AND event_type=?2 LIMIT 1"
                           (kernel-agent-id b) "fleet.op")) "and nothing was sent or queued")
      (is (search "not one of my peers" (funcall draft reflection "peer_id" "nobody" "text" "x")))
      (funcall draft reflection "peer_id" a-id "text" "second") (funcall draft reflection "peer_id" a-id "text" "third")
      (is (search "at most 3" (funcall draft reflection "peer_id" a-id "text" "fourth")) "a few drafts to a reflection")
      (is (search "left for"
                  (funcall (pai-v3.mind::tool-run (gethash "draft_fleet_message" pai-v3.mind::*tools*)) b
                           (request-thought b "responding" "not a reflection" :audience "operator")
                           (obj "peer_id" a-id "text" "x"))))
      ;; Still reflecting: nothing is said yet.
      (is (= 0 (pai-v3.api::speak-drafts b)))
      (append! b "thought.ended" (obj "thought_id" reflection "outcome" "concluded" "summary" "Done"))
      (is (= 3 (pai-v3.api::speak-drafts b)) "once it is over, each draft goes to a thought for its peer")
      (is (= 0 (pai-v3.api::speak-drafts b)) "once")
      (let* ((thoughts (sql-rows (kernel-db b) "SELECT id,origin,audience,reason FROM thoughts WHERE audience=?1 ORDER BY id LIMIT 10"
                                 (format nil "peer:~a" a-id)))
             (speaking (first thoughts)))
        (is (= 3 (length thoughts)))
        (is (equal "work" (second speaking)) "as the peer's own post would")
        (is (search "Happy to share the map notes." (fourth speaking)) "it is shown the words")
        (is (null (search "PRIVATE-REASON" (fourth speaking))) "never the reflection's reasons")
        (is (null (search "PRIVATE-REASON" (fourth (second thoughts)))))
        (let ((draft-id (sql-value (kernel-db b) "SELECT draft_id FROM fleet_drafts WHERE text=?1 LIMIT 1" "Happy to share the map notes."))
              (settle (lambda (thought &rest args)
                        (funcall (pai-v3.mind::tool-run (gethash "settle_draft" pai-v3.mind::*tools*)) b thought (apply #'obj args)))))
          (is (search "not for the peer" (funcall settle reflection "draft_id" draft-id "fate" "sent")) "only that peer's thought settles it")
          (is (search "Recorded" (funcall settle (first speaking) "draft_id" draft-id "fate" "edited" "note" "shortened")))
          (is (equal "edited" (sql-value (kernel-db b) "SELECT fate FROM fleet_drafts WHERE draft_id=?1 LIMIT 1" draft-id)))
          (is (search "not waiting" (funcall settle (first speaking) "draft_id" draft-id "fate" "sent")) "once"))))))

